if (!isApproved(ticket)) {
  await comment(ticket, 'BLOCKED: missing ✅ / APPROVE:<id>');
  return { result: 'BLOCKED' };
}
await applyState(ticket, {
  stage: 'AWAITING_AGENT_PICKUP',
  role: null, // AI transient → null
  agent: nextAgentFor(ticket) // convention table
}); // + native column sync
return { result: 'APPLIED' };`}</code></pre>
