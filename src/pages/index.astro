---
const siteUrl = "https://paligakrzychu.github.io/ai-alm-oss-landing";
const linkedIn = "https://www.linkedin.com/in/christopher-paliga-986352a7/";
const email = "picospitfire@icloud.com";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>ai-alm-oss — AI that helps teams ship, with human control</title>
		<meta name="description" content="ai-alm-oss is a research prototype that automates the repetitive parts of software delivery — from idea to traceable, auditable pull request — while a human approves every important step. Private prototype, demo on request." />
		<meta name="author" content="Krzysztof Paliga" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content="ai-alm-oss — AI that helps teams ship, with human control" />
		<meta property="og:description" content="From idea to traceable pull request — AI prepares, human approves, everything is logged. Research prototype, private demo on request." />
		<meta property="og:image" content={`${siteUrl}/og-image.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="ai-alm-oss — AI that helps teams ship, with human control" />
		<meta name="twitter:description" content="Automates the busywork in software delivery, keeps a human in charge of every decision." />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<style>
			@import "tailwindcss";
		</style>
	</head>
	<body class="bg-[#fafaf9] text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white">
		<!-- Header -->
		<header class="sticky top-0 z-50 backdrop-blur bg-white/80 border-b border-zinc-200">
			<div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
				<div class="flex items-center gap-2.5">
					<div class="w-7 h-7 rounded-md bg-zinc-900 flex items-center justify-center text-white text-[11px] font-bold tracking-widest">AAO</div>
					<span class="text-sm font-semibold tracking-tight">ai-alm-oss</span>
					<span class="hidden sm:inline-flex items-center gap-1.5 ml-2 px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-[11px] font-medium text-amber-800">● Private Prototype</span>
				</div>
				<nav class="hidden md:flex items-center gap-6 text-sm text-zinc-600">
					<a href="#in-30-seconds" class="hover:text-zinc-900 transition">In 30 seconds</a>
					<a href="#demo" class="hover:text-zinc-900 transition">Demo</a>
					<a href="#how-it-works" class="hover:text-zinc-900 transition">How it works</a>
				</nav>
				<div class="flex items-center gap-2">
					<a href={linkedIn} target="_blank" rel="noopener" class="hidden sm:inline-flex text-sm px-3.5 py-1.5 rounded-full border border-zinc-200 hover:border-zinc-300 hover:bg-zinc-50 transition">LinkedIn</a>
					<a href={`mailto:${email}?subject=Contact%20—%20ai-alm-oss`} class="text-sm px-4 py-1.5 rounded-full bg-zinc-900 text-white hover:bg-zinc-800 transition font-medium">Contact me</a>
				</div>
			</div>
		</header>

		<!-- Hero -->
		<section class="max-w-6xl mx-auto px-6 pt-14 pb-10 md:pt-20 md:pb-16">
			<div class="max-w-3xl">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-zinc-200 text-xs text-zinc-600 mb-5">
					<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
					Research Prototype • Jira + GitHub • Built for AI-First ALM
				</div>
				<h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.05]">
					I build AI that helps teams ship<br />
					<span class="text-zinc-500">— with human control.</span>
				</h1>
				<p class="mt-5 text-[17px] leading-7 text-zinc-600 max-w-2xl">
					<span class="font-medium text-zinc-900">ai-alm-oss</span> automates the repetitive parts of software delivery — from idea to tested code — while a human stays in charge of every important decision. Every step is traceable and reversible.
				</p>
				<p class="mt-3 text-sm leading-6 text-zinc-500 max-w-2xl">Particularly useful where auditability matters — in regulated B2B environments.</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href={`mailto:${email}?subject=Contact%20—%20ai-alm-oss&body=Hi%20Krzysztof%2C%0A%0AI%20saw%20ai-alm-oss%20and%20would%20like%20to%20learn%20more.%0A%0ABest%2C%0A`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-zinc-900 text-white text-sm font-medium hover:bg-zinc-800 transition">
						Contact me
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
					<a href={linkedIn} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-zinc-200 text-sm font-medium hover:bg-zinc-50 transition">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
						Connect on LinkedIn
					</a>
					<a href="#demo" class="inline-flex items-center px-5 py-2.5 rounded-full text-sm font-medium text-zinc-600 hover:text-zinc-900 transition">See demo ↓</a>
				</div>
				<p class="mt-4 text-xs text-zinc-500">Private research prototype — code and live walkthrough available on request (NDA-friendly). No tracking. No cookies.</p>
			</div>

			<!-- Simple flow preview -->
			<div class="mt-10 rounded-2xl border border-zinc-200 bg-white overflow-hidden shadow-sm">
				<div class="flex items-center gap-1.5 px-4 py-3 border-b border-zinc-100 bg-zinc-50/50">
					<span class="w-3 h-3 rounded-full bg-red-400"></span><span class="w-3 h-3 rounded-full bg-yellow-400"></span><span class="w-3 h-3 rounded-full bg-green-400"></span>
					<span class="ml-3 text-xs font-medium text-zinc-600">How a task moves</span>
					<span class="ml-auto hidden sm:inline text-xs text-zinc-400">One approved step at a time</span>
				</div>
				<div class="p-6 md:p-8">
					<div class="flex flex-wrap items-center gap-2 text-sm">
						<span class="px-3 py-1.5 rounded-full bg-zinc-900 text-white font-medium">Idea</span>
						<span class="text-zinc-300">→</span>
						<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200">AI prepares</span>
						<span class="text-zinc-300">→</span>
						<span class="px-3 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-800">Human approves</span>
						<span class="text-zinc-300">→</span>
						<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200">Tested code</span>
						<span class="text-zinc-300">→</span>
						<span class="px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700">Traceable PR</span>
					</div>
					<p class="mt-4 text-xs text-zinc-500">No step happens without a human OK. Every move is logged so you can audit it later — important in regulated B2B.</p>
				</div>
			</div>
		</section>

		<!-- In 30 seconds -->
		<section id="in-30-seconds" class="bg-white border-y border-zinc-200">
			<div class="max-w-6xl mx-auto px-6 py-12 md:py-16">
				<div class="max-w-2xl">
					<h2 class="text-2xl font-semibold tracking-tight">In 30 seconds</h2>
					<p class="mt-2 text-zinc-600">The problem I’m solving — and why it matters for B2B delivery.</p>
				</div>
				<div class="mt-8 grid md:grid-cols-3 gap-5">
					<div class="rounded-2xl border border-zinc-200 p-6">
						<div class="w-8 h-8 rounded-lg bg-zinc-100 flex items-center justify-center text-sm">⧗</div>
						<h3 class="mt-4 font-semibold">Delivery is slow</h3>
						<p class="mt-2 text-sm leading-6 text-zinc-600">Handovers between roles lose context. Status in Jira drifts from reality. Proving what changed — and why — takes extra work.</p>
					</div>
					<div class="rounded-2xl border border-zinc-200 p-6">
						<div class="w-8 h-8 rounded-lg bg-red-50 border border-red-200 flex items-center justify-center text-sm">⚠</div>
						<h3 class="mt-4 font-semibold">AI without guardrails is risky</h3>
						<p class="mt-2 text-sm leading-6 text-zinc-600">If AI does too much at once, no one can review it. Changes become hard to explain — a problem in regulated environments.</p>
					</div>
					<div class="rounded-2xl border border-zinc-900 bg-zinc-900 text-white p-6">
						<div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-sm">◆</div>
						<h3 class="mt-4 font-semibold">One step, one approval</h3>
						<p class="mt-2 text-sm leading-6 text-zinc-300">AI prepares the next step, a human approves, the move is logged. Only one helper works on a task at a time. Nothing gets stuck in an unclear state.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Demo -->
		<section id="demo" class="max-w-6xl mx-auto px-6 py-12 md:py-16">
			<div class="max-w-3xl">
				<h2 class="text-2xl font-semibold tracking-tight">See it in action</h2>
				<p class="mt-2 text-sm text-zinc-600">Anonymized Jira board. The task only moves to the next column after a human says yes. Every move appears as a comment — so the whole story is auditable later. Watch the comments panel in the animation.</p>
			</div>

			<div class="mt-8 rounded-2xl border border-zinc-200 bg-white overflow-hidden shadow-sm">
				<div class="aspect-[16/9] bg-zinc-50 flex flex-col items-center justify-center text-center relative overflow-hidden">
					<img src={`${import.meta.env.BASE_URL}/demo.gif`} alt="Jira board animation with comments appearing as the ticket moves" class="absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none'; document.getElementById('demo-fallback').style.display='flex'" />
					<div id="demo-fallback" class="flex flex-col items-center justify-center gap-4 p-6" style="display: none;">
						<div class="flex items-center gap-2 text-xs">
							<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200 shadow-sm">Backlog</span>
							<span class="text-zinc-300">→</span>
							<span class="px-3 py-1.5 rounded-full bg-sky-50 border border-sky-200 shadow-sm animate-pulse">In progress</span>
							<span class="text-zinc-300">→</span>
							<span class="px-3 py-1.5 rounded-full bg-amber-50 border border-amber-200 shadow-sm">Needs approval</span>
							<span class="text-zinc-300">→</span>
							<span class="px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 shadow-sm">Done</span>
						</div>
						<p class="text-xs text-zinc-500 max-w-md">Demo shows a task moving across the board with comments appearing for each step. Final GIF: board + comments panel.</p>
					</div>
				</div>
				<div class="px-5 py-4 bg-zinc-50 border-t border-zinc-100 flex flex-wrap items-center justify-between gap-3 text-xs">
					<span class="text-zinc-600">Each column move leaves a comment — the history stays visible for audit.</span>
					<span class="text-zinc-400">Board: anonymized • No customer data</span>
				</div>
			</div>
		</section>

		<!-- How it works (collapsed for HR, open for tech) -->
		<section id="how-it-works" class="bg-white border-y border-zinc-200">
			<div class="max-w-6xl mx-auto px-6 py-12 md:py-16">
				<details class="group rounded-2xl border border-zinc-200 bg-zinc-50 open:bg-white transition">
					<summary class="list-none flex items-center justify-between gap-4 px-6 py-5 cursor-pointer">
						<div>
							<h2 class="text-lg font-semibold tracking-tight">How it works — for technical reviewers</h2>
							<p class="mt-1 text-sm text-zinc-600">State machine, step-by-step handover, and stack. Closed by default to keep the page light for HR.</p>
						</div>
						<span class="shrink-0 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900 text-white text-xs font-medium group-open:hidden">Show details</span>
						<span class="shrink-0 hidden group-open:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-zinc-200 text-xs font-medium">Hide details</span>
					</summary>
					<div class="px-6 pb-8 pt-2">
						<!-- Pipeline detail -->
						<div class="mt-4">
							<h3 class="text-sm font-semibold">One ticket, one column move at a time</h3>
							<p class="mt-1 text-sm text-zinc-600 max-w-3xl">The orchestrator knows the full state machine but never duplicates a specialist’s work. One step = one allowed move. The chosen helper then does the work. If a move isn’t allowed, the system leaves a comment explaining why — instead of failing silently.</p>
							<div class="mt-5 rounded-xl border border-zinc-200 bg-white overflow-hidden">
								<div class="overflow-x-auto">
									<table class="w-full text-sm">
										<thead class="bg-zinc-50 border-b border-zinc-200 text-xs text-zinc-500">
											<tr><th class="text-left px-4 py-2.5 font-medium">Stage</th><th class="text-left px-4 py-2.5 font-medium">What happens</th><th class="text-left px-4 py-2.5 font-medium">Who’s next</th><th class="text-left px-4 py-2.5 font-medium">Needs human OK</th></tr>
										</thead>
										<tbody class="divide-y divide-zinc-100 text-xs">
											<tr><td class="px-4 py-2.5">Candidate approved</td><td class="px-4 py-2.5 text-zinc-500">AI analyzes the issue</td><td class="px-4 py-2.5">po-analyze</td><td class="px-4 py-2.5">PO</td></tr>
											<tr><td class="px-4 py-2.5">Requirements approved</td><td class="px-4 py-2.5 text-zinc-500">Decompose into smaller tasks</td><td class="px-4 py-2.5">po-decompose</td><td class="px-4 py-2.5">PO</td></tr>
											<tr><td class="px-4 py-2.5">Split done</td><td class="px-4 py-2.5 text-zinc-500">QA scenarios</td><td class="px-4 py-2.5">qa-analyze</td><td class="px-4 py-2.5">—</td></tr>
											<tr><td class="px-4 py-2.5">QA approved</td><td class="px-4 py-2.5 text-zinc-500">Architecture review</td><td class="px-4 py-2.5">arch-analyze</td><td class="px-4 py-2.5">QA</td></tr>
											<tr><td class="px-4 py-2.5">Architecture approved</td><td class="px-4 py-2.5 text-zinc-500">Security review</td><td class="px-4 py-2.5">sec-analyze</td><td class="px-4 py-2.5">ARCH</td></tr>
											<tr><td class="px-4 py-2.5">Security approved</td><td class="px-4 py-2.5 text-zinc-500">Technical contract</td><td class="px-4 py-2.5">dev-analyst</td><td class="px-4 py-2.5">SEC</td></tr>
											<tr><td class="px-4 py-2.5">Contract approved</td><td class="px-4 py-2.5 text-zinc-500">Build the feature</td><td class="px-4 py-2.5">dev-impl</td><td class="px-4 py-2.5">DEV</td></tr>
											<tr><td class="px-4 py-2.5">Feature ready</td><td class="px-4 py-2.5 text-zinc-500">Write tests</td><td class="px-4 py-2.5">qa-impl</td><td class="px-4 py-2.5">—</td></tr>
											<tr><td class="px-4 py-2.5">Tests ready</td><td class="px-4 py-2.5 text-zinc-500">Verify</td><td class="px-4 py-2.5">verify</td><td class="px-4 py-2.5">—</td></tr>
											<tr><td class="px-4 py-2.5">Verified</td><td class="px-4 py-2.5 text-zinc-500">Open pull request</td><td class="px-4 py-2.5">pr</td><td class="px-4 py-2.5">Lead</td></tr>
										</tbody>
									</table>
								</div>
								<div class="px-4 py-2.5 bg-amber-50 border-t border-amber-100 text-xs text-amber-800">Handover: a human hands off by marking the ticket for AI. The orchestrator then moves it to “waiting for helper” and picks the right specialist. Re-running is safe — it simply does nothing the second time.</div>
							</div>
						</div>

						<!-- Governance -->
						<div class="mt-8 grid lg:grid-cols-2 gap-6">
							<div class="rounded-xl border border-zinc-200 overflow-hidden bg-white">
								<div class="px-4 py-3 bg-zinc-900 text-white text-sm font-medium">Status is three things at once</div>
								<div class="p-4 space-y-4 text-sm">
									<div>
										<div class="text-xs font-semibold text-zinc-500 tracking-widest">WHERE IS IT</div>
										<div class="mt-1.5 flex flex-wrap gap-1.5 text-xs">
											<span class="px-2 py-1 rounded bg-zinc-100 border border-zinc-200">Backlog</span>
											<span class="px-2 py-1 rounded bg-amber-50 border border-amber-200">Needs human OK</span>
											<span class="px-2 py-1 rounded bg-sky-50 border border-sky-200">Waiting for helper</span>
											<span class="px-2 py-1 rounded bg-indigo-50 border border-indigo-200">Helper working</span>
											<span class="px-2 py-1 rounded bg-emerald-50 border border-emerald-200">Ready</span>
											<span class="px-2 py-1 rounded bg-zinc-900 text-white">Done</span>
										</div>
										<p class="mt-1 text-xs text-zinc-500">Maps to Jira column + custom field. One move = one column.</p>
									</div>
									<div>
										<div class="text-xs font-semibold text-zinc-500 tracking-widest">WHO OWNS IT</div>
										<div class="mt-1.5 flex flex-wrap gap-1.5 text-xs">
											<span class="px-2 py-1 rounded bg-white border border-zinc-200">PO</span>
											<span class="px-2 py-1 rounded bg-white border border-zinc-200">DEV</span>
											<span class="px-2 py-1 rounded bg-white border border-zinc-200">QA</span>
											<span class="px-2 py-1 rounded bg-white border border-zinc-200">SEC</span>
											<span class="px-2 py-1 rounded bg-white border border-zinc-200">ARCH</span>
											<span class="px-2 py-1 rounded bg-violet-50 border border-violet-200">AI (temporary handover)</span>
										</div>
										<p class="mt-1 text-xs text-zinc-500">One owner at a time. Parallel work = separate tasks.</p>
									</div>
									<div>
										<div class="text-xs font-semibold text-zinc-500 tracking-widest">WHICH HELPER</div>
										<div class="mt-1 text-xs text-zinc-700"><span class="px-2 py-1 rounded bg-white border border-zinc-200">none</span> <span class="text-zinc-400">+ 18 specialists</span> <span class="ml-1 px-1.5 py-0.5 rounded bg-zinc-100 text-xs">aialm-oss-*</span></div>
										<p class="mt-1 text-xs text-zinc-500">Only the assigned helper may change the ticket at that step.</p>
									</div>
								</div>
							</div>
							<div class="space-y-4">
								<div class="rounded-xl border border-zinc-200 bg-amber-50 p-4">
									<h4 class="text-sm font-semibold text-amber-900">Simple rules, no grey areas</h4>
									<ul class="mt-2 space-y-1.5 text-xs leading-5 text-amber-900/80">
										<li>• Only one helper works on a ticket at a time.</li>
										<li>• “Done” always means no active owner.</li>
										<li>• “Hand over to AI” is a temporary flag — it disappears after pickup.</li>
										<li>• No vague “blocked” — if something’s missing, the ticket stays put and gets a comment explaining what’s needed.</li>
									</ul>
								</div>
								<div class="rounded-xl border border-zinc-200 p-4 bg-white">
									<h4 class="text-sm font-semibold">Allowed moves only</h4>
									<div class="mt-2 grid grid-cols-1 gap-1.5 text-xs text-zinc-600">
										<div class="flex items-center gap-2"><span class="px-2 py-1 rounded bg-zinc-100">Backlog</span> <span class="text-zinc-400">→</span> <span class="px-2 py-1 rounded bg-sky-50 border border-sky-200">Waiting for helper</span> <span class="text-zinc-400 ml-auto">helper starts</span></div>
										<div class="flex items-center gap-2"><span class="px-2 py-1 rounded bg-sky-50 border border-sky-200">Waiting</span> <span class="text-zinc-400">→</span> <span class="px-2 py-1 rounded bg-indigo-50 border border-indigo-200">Working</span> <span class="text-zinc-400 ml-auto">same helper</span></div>
										<div class="flex items-center gap-2"><span class="px-2 py-1 rounded bg-indigo-50 border border-indigo-200">Working</span> <span class="text-zinc-400">→</span> <span class="px-2 py-1 rounded bg-amber-50 border border-amber-200">Needs OK</span> <span class="text-zinc-400 ml-auto">helper done</span></div>
										<div class="flex items-center gap-2"><span class="px-2 py-1 rounded bg-amber-50 border border-amber-200">Needs OK</span> <span class="text-zinc-400">→</span> <span class="px-2 py-1 rounded bg-sky-50 border border-sky-200">Waiting</span> <span class="text-zinc-400 ml-auto">human approves</span></div>
										<div class="flex items-center gap-2"><span class="px-2 py-1 rounded bg-emerald-50 border border-emerald-200">Ready</span> <span class="text-zinc-400">→</span> <span class="px-2 py-1 rounded bg-sky-50 border border-sky-200">Waiting</span> <span class="text-zinc-400 ml-auto">next helper</span></div>
									</div>
									<p class="mt-3 text-xs text-zinc-500">Anything else is rejected with a comment — helpers can’t invent new states.</p>
								</div>
							</div>
						</div>

						<!-- Stack -->
						<div class="mt-8">
							<h3 class="text-sm font-semibold">Stack — boring, auditable</h3>
							<div class="mt-3 flex flex-wrap gap-2 text-xs">
								<span class="px-3 py-1.5 rounded-full bg-zinc-900 text-white">TypeScript</span>
								<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200">Node 22</span>
								<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200">Jira Cloud REST</span>
								<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200">Docker</span>
								<span class="px-3 py-1.5 rounded-full bg-white border border-zinc-200">Vitest + Playwright</span>
