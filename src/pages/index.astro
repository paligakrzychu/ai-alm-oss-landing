						<pre class="p-4 text-xs font-mono leading-5 overflow-x-auto text-zinc-100"><code>{`export function assertConsistent(s: TicketState): string[] {
  const e: string[] = [];
  if (s.agent === 'none') {
    if (!NO_AGENT_STAGES.includes(s.stage))
      e.push(\`AGENT=none but STAGE=\${s.stage} requires agent\`);
  } else {
    if (!ACTIVE_AGENT_STAGES.includes(s.stage))
      e.push(\`AGENT=\${s.agent} but STAGE=\${s.stage} must be active\`);
  }
  if (s.role === 'AI' && s.agent !== 'none')
    e.push('ROLE=AI requires AGENT=none (transient)');
  return e;
}`}</code></pre>
